# MONGODB_URI: MongoDB Atlas connection string (REQUIRED).
# The app will FAIL TO START if this is not configured - no local file fallback.
# Set this in Vercel Environment Variables for production deployment.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.ex.mongodb.net/terminalchat?retryWrites=true&w=majority"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
